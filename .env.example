# Copy this file to .env and fill in the values before running in production.

# Express session secret — use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# New installations only: set a unique password of at least 12 characters.
# Existing administrator accounts are never changed by this setting.
INITIAL_ADMIN_PASSWORD=
